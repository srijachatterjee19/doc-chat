# Google Analytics 4 (frontend)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay payments
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=your_secret_here

# No API key needed — Ollama runs locally
# Make sure Ollama is running: https://ollama.com

# PostgreSQL — required for chat history
DATABASE_URL=postgresql://user:password@localhost:5432/ragchatbot

# LangSmith observability (optional)
# Get your API key at https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_PROJECT=rag-chatbot
